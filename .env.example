# "production" makes the site indexable. Anything else (default) is a noindex preview.
NEXT_PUBLIC_SITE_ENV=preview

# Final origin used for canonical URLs, hreflang, sitemap and structured data.
# Required when NEXT_PUBLIC_SITE_ENV=production. Leave unset for local previews.
# NEXT_PUBLIC_SITE_URL=https://www.example.de

# --- Meta Pixel + Conversions API (ads tracking; only fires after marketing consent) ---
# Events Manager → Data sources → your dataset → Settings → "Dataset ID".
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → dataset → Settings → Conversions API → "Generate access token". Server-only, never NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Optional, only while testing: Events Manager → Test events → "Test event code". Remove for live traffic.
META_TEST_EVENT_CODE=

# --- Cal.com webhook (POST /api/cal-webhook, trigger BOOKING_CREATED) ---
# Must equal the "Secret" configured on the Cal.com webhook.
CAL_WEBHOOK_SECRET=
